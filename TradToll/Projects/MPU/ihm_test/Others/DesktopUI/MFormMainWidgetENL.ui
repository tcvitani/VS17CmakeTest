QWidget{
	background-color: transparent;
	font: bold 11pt &quot;Century Gothic&quot;;
}

/* transaction details */
#TxtTransactionNbr,
#TxtSaleDue,
#TxtFare,
#TxtAdditionalRevenue
{
	font-size: 20pt;
}

#TxtPlazaNbr,
#TxtRemark
{
	font-size: 16pt;
}

/* section titles */
#TxtAlertesTitle,
#TxtTrsHistoryTitle,
#TxtAlarmsTitle,
#TxtTrsContainerTitle
{
	font-size: 13pt;
}

#btnMode QPushButton,
#TxtSaleDueTitle
{
	font-size: 14pt;
}


#TxtPlazaNbr
{
	background-color: transparent;
	border:none;
}

#TxtInstruction, #TxtInstruction2
{
	color: #633285;
}</string>
