}

QFrame#frContent QPushButton
{
	border: 1px solid #4d4d4d;	
	border-radius:5px;
	padding:5px 5px 5px 5px;
	min-height:  18px;
	max-height:  18px;
	min-width:  120px;
	max-width:  120px;
	text-align: center;
	color:#e6e6e6;
	font: 10pt &quot;CachetBold&quot;;
}

QFrame#frContent QPushButton#btnConnect,
QFrame#frContent QPushButton#btnDisconnect
{
	min-height:  18px;
	max-height:  18px;
	min-width:  30px;
	max-width:  1000px;
}

QFrame#frContent QPushButton#btnBrowse
{
	min-height: 18px;
	max-height: 18px;
	min-width: 18px;
	max-width: 18px; 
}


QFrame#frContent QPushButton:disabled
{
	text-decoration:none;
	color:#cacaca;
	background-color:#1a1a1a;
	border: 1px solid #4d4d4d;	
}

QFrame#frContent QPushButton:pressed
{
	padding:6px 5px 5px 5px;
  	color:#ffffff;	
}

QFrame#frContent QPushButton:hover
{
	padding:7px 5px 5px 5px;
}

QFrame#frContent QPushButton:focus
{
	border: 1px solid #4d4d4d;	
}

