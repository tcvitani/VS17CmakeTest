    <string notr="true">
QFrame{
	background-color: transparent;
	border:none;
	
}

QFrame#CntSpare2{
	color: rgb(193, 193, 193);
	background-color: transparent;
	border-width: 8px;
	border-image: url(c:/csr/exe/images/virtual-keyboard/Keyboard-border-image.png) 8 10 10 8 stretch stretch;
}

QPushButton 
{
	background-color: transparent;
	font-weight: bold;
	font-size:10pt; 
	border-width: 8px;
}

QPushButton 
{
	border-image: url(c:/csr/exe/images/virtual-keyboard/keyboard-button-frame-normal.png) 10 10 10 10 stretch stretch;	
}

QPushButton:disabled
{
	border-image: url(c:/csr/exe/images/virtual-keyboard/keyboard-button-frame-normal-disabled.png) 10 10 10 10 stretch stretch;	
}

QPushButton:pressed
{
	border-image: url(c:/csr/exe/images/virtual-keyboard/keyboard-button-frame-normal-pressed.png) 10 10 10 10 stretch stretch;	
}



#btnSpare2 *, 
#btnSpare17 *
{
	color: rgb(255, 255, 255);
	background-color: rgb(6, 29, 106);

}





#btnSpare22 *, 
#btnSpare23 *
{
	color: rgb(255, 255, 255);
	background-color: #DDD;
}


#btnSpare1 *
{
	color: rgb(255, 255, 255);
	background-color:  rgba(0, 170, 0, 255);
}


#btnSpare1,
#btnSpare2,
#btnSpare3,
#btnSpare4,
#btnSpare5,
#btnSpare10,
#btnSpare14,
#btnSpare17,
#btnSpare20 
{
 width:170px;
}

#btnSpare2 QPushButton:disabled, 
#btnSpare3 QPushButton:disabled, 
#btnSpare4 QPushButton:disabled, 
#btnSpare5 QPushButton:disabled, 
#btnSpare17 QPushButton:disabled,
#btnSpare22 QPushButton:disabled, 
#btnSpare23 QPushButton:disabled, 
#btnSpare1 QPushButton:disabled, 
#btnSpare6 QPushButton:disabled, 
#btnSpare7 QPushButton:disabled, 
#btnSpare12 QPushButton:disabled, 
#btnSpare14 QPushButton:disabled,  
