<?xml version="1.0" encoding="UTF-8"?>
<input_definition desktop_css_file="DialogStyleNEP.css" >

	<widget type="Label" name="lblTitle" />

	<widget type="Label" name="lblPIB" />
	<widget type="LineEditExt" name="txtPIB" format="M" format_detail=">00000000"  />
	<widget type="Label" name="lblDateTime" />
	<widget type="LineEditExt" name="txtDateTime" format="M" format_detail=">0000-00-00A00:00:00+00:00" validator="[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)"  />
	<widget type="Label" name="lblReceiptNb" />
	<widget type="LineEditExt" name="txtReceiptNb" format="M" validator="[a-z]{2}[0-9]{3}[a-z]{2}[0-9]{3}\/[1-9]{1}[0-9]{0,14}\/[0-9]{4}\/[a-z]{2}[0-9]{3}[a-z]{2}[0-9]{3}" />
	<widget type="Label" name="lblBussinesID" />
	<widget type="LineEditExt" name="txtBussinesID" format="C" min_len="0" max_len="10" validator="[a-z]{2}[0-9]{3}[a-z]{2}[0-9]{3}" />
	<widget type="Label" name="lblEnu" />
	<widget type="LineEditExt" name="txtEnu" format="C" min_len="0" max_len="10" validator="[a-z]{2}[0-9]{3}[a-z]{2}[0-9]{3}" />
	<widget type="Label" name="lblSoftwareCode" />
	<widget type="LineEditExt" name="txtSoftwareCode" format="C" min_len="0" max_len="10" validator="[a-z]{2}[0-9]{3}[a-z]{2}[0-9]{3}" />
	<widget type="Label" name="lblPrice" />
	<widget type="LineEditExt" name="txtPrice" format="N" format_detail="N3,2" validator="^([1-9][0-9]{0,2}|0)[,\.][0-9]{2}$"/>

	<widget type="PushButtonOK" name="btnOK" />
	<widget type="PushButtonCancel" name="btnCancel" />

</input_definition>