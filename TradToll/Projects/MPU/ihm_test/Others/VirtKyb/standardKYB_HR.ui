      <string notr="true">
QFrame{
	background-color: transparent;
}


QFrame#frMainFrame{
    color: rgb(0, 180, 225);
	background-color: #bfecf7;
}


QPushButton 
{
background-color: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #fefefe, stop:1 #bfecf7);
border: 2px solid #00b4E1;
}

QPushButton:disabled
{
background-color: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #dcdcdc, stop:1 rgb(149, 192, 225));
color: #b2b2b2;
border-color: #00b4E1;
}

QPushButton::pressed
{
background-color: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1  rgb(149, 192, 225)c);
color: #888888;
}

QPushButton 
{
font-weight: bold;
font-size:14pt;
}

#btnNumpadMINUS,#btnNumpadPLUS
{
 width: 55px;
}

#btnCANCEL
{
background-color: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #fefefe, stop:1 #FF0000);
border: 2px solid #00b4E1;
width:120px;
}

#btnVALID
{
background-color: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #fefefe, stop:1 #00FF00);
border: 2px solid #00b4E1;
width:120px;
}
