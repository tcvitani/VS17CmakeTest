/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU MENU
BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "&Exit",                       IDM_EXIT
    END
    POPUP "Services"
    BEGIN
        POPUP "Affichage"
        BEGIN
            MENUITEM "Start",                       IDM_AFFICHAGE_DEBUT
            MENUITEM "Stop",                        IDM_AFFICHAGE_FIN
            MENUITEM SEPARATOR
            MENUITEM "Display",                     IDM_AFFICHAGE_DISPLAY
            POPUP "Backlight"
            BEGIN
                MENUITEM "ON",                          IDM_AFFICHAGE_BACKLIGHT_ON
                MENUITEM "OFF",                         IDM_AFFICHAGE_BACKLIGHT_OFF
            END
            MENUITEM "Reset",                       IDM_AFFICHAGE_RESET
            MENUITEM "New File",                    IDM_AFFICHAGE_NEW_FILE
            MENUITEM "Performance Test",            IDM_AFFICHAGE_PERFO_TEST
        END
        POPUP "Espion"
        BEGIN
            MENUITEM "Start",                       IDM_ESPION_START
            MENUITEM "Stop",                        IDM_ESPION_END
        END
        POPUP "Visu"
        BEGIN
            MENUITEM "Start",                       IDM_VISU_DEBUT
            MENUITEM "Stop",                        IDM_VISU_FIN
            MENUITEM SEPARATOR
            MENUITEM "Request of Visu",             IDM_VISU_VISU
        END
        POPUP "Etat"
        BEGIN
            MENUITEM "Start",                       IDM_ETAT_DEBUT
            MENUITEM "Stop",                        IDM_ETAT_FIN
            MENUITEM SEPARATOR
            MENUITEM "Status of service",           IDM_ETAT_ETAT
        END
        POPUP "Device Info"
        BEGIN
            MENUITEM "Start",                       ID_DEVICEINFO_START
            MENUITEM "Stop",                        ID_DEVICEINFO_STOP
            MENUITEM SEPARATOR
            MENUITEM "Get Device info",             ID_DEVICEINFO_GETDEVICEINFO
        END
        POPUP "Arret"
        BEGIN
            MENUITEM "Module AFF stoping",          IDM_ARRET_ARRET
        END
    END
    POPUP "MailBox"
    BEGIN
        MENUITEM "BAL_A",                       IDM_BAL_A, CHECKED
        MENUITEM "BAL_B",                       IDM_BAL_B
        MENUITEM "BAL_C",                       IDM_BAL_C
        MENUITEM "BAL_D",                       IDM_BAL_D
    END
    POPUP "Info"
    BEGIN
        MENUITEM "About",                       IDM_ABOUT
    END
END

