}

QCheckBox {
	spacing: 5px;
  	color:#e6e6e6;
	background: #e6e6e6;
 	background-color: #1a1a1a;
}

QCheckBox::indicator {
width: 14px;
height: 14px;
	border: none;	
}

QCheckBox::indicator:unchecked:disabled {
image: url(:/Images/chk_unchecked_disabled.png);
}

QCheckBox::indicator:checked{
image: url(:/Images/chk_checked.png);
}

QCheckBox::indicator:unchecked:disabled {
image: url(:/Images/chk_unchecked_disabled.png);
}

QCheckBox::indicator:unchecked{
image: url(:/Images/chk_unchecked.png);
}

/* Customize radio buttons. */ 

QRadioButton {
	spacing: 5px;
  	color:#e6e6e6;
	background: #e6e6e6;
 	background-color: #1a1a1a;
}


QRadioButton::indicator {
width: 14px;
height: 14px;
}

QRadioButton::indicator::unchecked {
image: url(:/Images/radiobnone.png);
}


QRadioButton::indicator:checked{
image: url(:/Images/radiobcheck.png);
}


QFrame#frStatusBar
{
	background-color: transparent;
