}


QFrame#frContent QScrollArea
{ 
  	color:#e6e6e6;
	background: #e6e6e6;
 	background-color: #1a1a1a;
	border: 1px solid #4d4d4d;	
  	border-left-width:0px;
   	border-right-width:0px;
     border-radius: 0px;
     padding: 0px;
     selection-background-color: darkgray;
}

QScrollBar:vertical {
    border-radius:0px; 
    border: 1px solid #4d4d4d;	
     background: #1a1a1a;
     width: 20px;
     margin: 30px 0px 30px 0px;
 }
 QScrollBar::handle:vertical {
     background: #dddddd;
     min-height: 20px;
 }
 QScrollBar::add-line:vertical {
     border-radius: 0px; 
	border: 1px solid #4d4d4d;	
    border-bottom-width:0px;
   border-top-width:0px;
  border:none;
     background:  #1a1a1a;
     height: 20px;
     subcontrol-position: bottom;
     subcontrol-origin: margin;
 margin-bottom: 5px;
 }

 QScrollBar::sub-line:vertical {
 border-radius: 0px;    
 border: 1px solid #4d4d4d;	
    border-bottom-width:0px;
   border-top-width:0px;
  border:none;
   background:#1a1a1a;
     height: 20px;
     subcontrol-position: top;
     subcontrol-origin: margin;
 margin-top: 5px;
 }

 QScrollBar::up-arrow:vertical {
     image: url(:/Images/spin_up.png);
    width: 10px;
    height: 10px;
 }

QScrollBar::down-arrow:vertical {
     image: url(:/Images/spin_down.png);
    width: 10px;
    height: 10px;
 }

 QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
     background: none;
 }


/*Customizing pop-up list of the QComboBox*/
 QComboBox QAbstractItemView {
	color:#e6e6e6;
    	border: 1px solid #4d4d4d;
	background-color: #1a1a1a;
    	selection-background-color: darkgray;
 }
 
QComboBox { 
    	padding-right: 25px;
	font:11pt &quot;Arial&quot;;
  	color:#e6e6e6;
	background: #e6e6e6;
 	background-color: #1a1a1a;
	border: 1px solid #4d4d4d;	
    border-radius: 5px;
    padding: 0 8px;
	height:30px;

    selection-background-color: darkgray;
	min-height: 1.3em;
}

QComboBox::drop-down {	
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;

    border-left-width: 1px;
    border-left-color: darkgray;
    border-left-style: solid; /* just a single line */
    border-top-right-radius: 3px; /* same radius as the QComboBox */
    border-bottom-right-radius: 3px;
	padding:1px;
}
 
QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QComboBox::down-arrow {
    image: url(:/Images/spin_down.png);
    width: 9px;
    height: 9px;
}

QSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:disabled,
QComboBox::down-arrow:disabled {
   image: url(:/Images/spin_down_disabled.png);
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(:/Images/spin_up.png);
    width: 9px;
    height: 9px;
}

QSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:disabled {
   image: url(:/Images/spin_up_disabled.png);
}

QSpinBox,
QDoubleSpinBox { 
    padding-right: 25px;
  	color:#e6e6e6;
	background: #e6e6e6;
 	background-color: #1a1a1a;
	border: 1px solid #4d4d4d;	
     border-radius: 5px;
     padding: 0 5px;
	 height:22px;

     selection-background-color: darkgray;
	min-height: 22px;

}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
 	height:12px;
    width: 20px; /* 16 + 2*1px border-width = 15px padding + 3px parent border */
    /*border-image: url(:/Images/spinup.png) 1;*/
	border: 1px solid #4d4d4d;	
   border-bottom-width:0px;     
   border-top-width:0px;     
  border-right-width:0px;     

margin:0px 2px 0px 2px;
padding:1px;
	background-color: transparent;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
	height:12px;
    width: 20px;
	border: 1px solid #4d4d4d;	
    border-top-width:0px;     
	border-bottom-width:0px;     
    border-right-width:0px;     
	margin:0px 2px 1px 2px;
	background-color: transparent;
	padding:1px;
    
}

QFrame#frContent QLabel,
QFrame#frContent QCheckBox,
QFrame#frContent QRadioButton
{
	font: 12pt &quot;CachetBold&quot;;
}</string>
