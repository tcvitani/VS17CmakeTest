    <string notr="true">/* menu and buttons general style*/
QMenuBar,
QMenuBar::item,
QMenu::item,
QPushButton
{
	font-weight: normal;
	font-size:10pt;
}

/* header background elements shared options */
#CntHeaderGroup,
#CntMenuLeft
{
    margin-left:0px;
	background-repeat: no-repeat;
	background-attachment: fixed;
	background-color: transparent;
	background-position: left top;
	background-image: url(c:/csr/exe/images/header-background.png);
}

	/* take over and return control buttons style */
	QPushButton
	{
		background-color: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #fefefe, stop:1 #b2b2b2);
		border: 1px solid #666666;
    }

	QPushButton:disabled
	{
		background-color: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #dcdcdc, stop:1 #cccccc);
		color: #b2b2b2;
		border-color: #b2b2b2;
	}

	QPushButton::pressed
	{
		background-color: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #cccccc);
		color: #888888;
	}






QMenuBar
{
}

	QMenuBar::item
	{
		border: 1px solid #666666;
		background-color: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #fefefe, stop:1 #b2b2b2);
		padding-left: 5px;
		padding-right: 5px;
		padding-top: 3px;
		padding-bottom: 2px;

	}
	QMenuBar::item:pressed,
	QMenuBar::item:selected
	{
		background-color: #fefefe;
	}

QMenu
{
	background-color: #fff;
	border: 1px solid #666666;
	margin: 0px;
}

	QMenu::item
	{
		padding: 4px 30px 4px 15px;
		background-color: #fff;
	}

	QMenu::item:disabled
	{
		color: #b2b2b2;
	}

	QMenu::item:selected
	{
		background-color: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #fefefe, stop:1 #b2b2b2);
		border-bottom: 1px solid #666666;
		border-top: 1px solid #666666;
		margin: 0px;
	}

	QMenu::separator
	{
		height: 2px;
		background-color: #b2b2b2;
	}

	QMenu::indicator
	{
		width: 13px;
		height: 13px;
		color: #b2b2b2;
	}

</string>
