<?xml version="1.0" encoding="UTF-8"?>
<input_definition desktop_css_file="DialogStyleNEP.css">
	<widget type="Label" name="lblTitle"/>
	<widget type="Label" name="lblMessage"/>
	<widget type="Label" name="lblDeviseNameTitle"/>
	<widget type="LineEdit" name="txtDeviseName"/>
	<widget type="HiddenLineEdit" name="txtDeviseRate"/>
	<widget type="Label" name="lblDeviseTitle"/>
	<widget type="LineEditExt" name="txtDeviseValue" format="N" format_detail="N5,2" validator="^([1-9][0-9]{0,4}|0)[,\.][0-9]{2}$"/>
	<widget type="Label" name="lblChangeTitle"/>
	<widget type="LineEditExt" name="txtChangeValue" format="F" format_detail="txtDeviseValue*txtDeviseRate" result_precision="2" />
	<widget type="PushButtonOK" name="btnOK"/>
	<widget type="PushButtonCancel" name="btnCancel"/>
</input_definition>
