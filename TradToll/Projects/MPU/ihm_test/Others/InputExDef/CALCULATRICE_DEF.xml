<?xml version="1.0" encoding="UTF-8"?>
<input_definition desktop_css_file="DialogStyleNEP.css">
	<widget type="Label" name="lblTitle"/>
	<widget type="Label" name="lblAmountTitle"/>
	<widget type="LineEditExt" name="txtAmountValue" format="N" format_detail="N4,2" validator="^([1-9][0-9]{0,3}|0)[,\.][0-9]{2}$"/>
	<widget type="Label" name="lblPayedTitle"/>
	<widget type="LineEditExt" name="txtPayedValue" format="N" format_detail="N4,2" validator="^([1-9][0-9]{0,3}|0)[,\.][0-9]{2}$"/>
	<widget type="Label" name="lblChangeTitleA"/>
	<widget type="Label" name="lblChangeTitleB"/>
	<widget type="LineEditExt" name="txtChangeValue" format="F" format_detail="Math.abs(txtPayedValue-txtAmountValue)" result_precision="2" enable_label_switching="1" label_false="lblChangeTitleB" label_true="lblChangeTitleA" lbl_switch_formula="(txtPayedValue-txtAmountValue)>=0"/>
	<widget type="PushButtonOK" name="btnOK"/>
</input_definition>
