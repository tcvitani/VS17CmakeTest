     <property name="styleSheet">
      <string notr="true">QDialog{
	background-color: transparent;
	display: none;
}


#frContainer
{
	background-color: transparent;
	border-width: 8px;
	border-image: url(./images/dialog/image-dialog-border-image_sozina.png) 8 10 10 8 stretch stretch;
	
}

QFrame,
QAbstractSpinBox,
QAbstractButton,
QAbstractItemView,
QComboBox,
QLineEdit,
QProgressBar,
QPushButton,
QListView
{
	color: #000;
	font-family: Century Gothic;
	font-size: 15px;
	font-weight: bold;
}

QAbstractSpinBox,
QComboBox,
QAbstractItemView,
QPlainTextEdit,
QTextEdit,
QLineEdit,
QListView
{
	background-color: #fff;
	border: 2px solid #633285;
}

QAbstractSpinBox,
QComboBox,
QAbstractItemView,
QPlainTextEdit,
QTextEdit,
QLineEdit,
QListView
{
	margin: 0px;
}

QLabel
{
	margin: 0px 5px 5px 0px;
}

QLabel,
QPushButton,
QRadioButton
{
	background-color: transparent;
}

QAbstractItemView
{
     selection-background-color: black;
	 selection-color: white;
}

QLineEdit:disabled{
	background-color: #d8cbe0;
	color: #633285;
}

QPushButton, QLabel					{	color: #633285;	}


QPushButton{	border-width: 8px;
	border-image: url(./images/dialog/image-dialog-border-image_sozina.png) 8 10 10 8 stretch stretch;
}

QPushButton#btnOK					{	background-image: url(./images/dialog/button-default.png);			}
QPushButton#btnOK:pressed			{	background-image: url(./images/dialog/button-default-pressed.png);	}
QPushButton#btnOK:disabled			{	background-image: url(./images/dialog/button-default-disabled.png);	}

QProgressBar
{
	border: 2px solid grey;
	border-radius: 5px;
	text-align: center;
	color: #633285;
}

QProgressBar::chunk
{
	background-color: #d8cbe0;
	width: 20px;
}

#lblTitle
{
	color: white;

	border-width: 14px;
	border-image: url(./images/dialog/image-title-background-border-image.png) 14 14 14 14 stretch stretch;
	background-image: url(./images/dialog/image-title-background-background-image.png);

	margin: 0px 0px 5px 0px;
	padding: -5px 0px;
}

QPushButton, 
#lblTitle,
#lblSubtitle
{
	font-size: 19px;
	text-transform: uppercase;
}

#lblSubtitle
{
	text-transform: none;
}

#lblMessage
{
	margin-bottom: 12px;
}

#frmOptions1,
#frmOptions2,
#frmOptions3,
#frmOptions4
{
	padding-top: -9px;
	background-color: transparent;
}


QComboBox::drop-down
{
	height: 20px;
	width: 20px;
}

QLineEdit,
QComboBox,
QListView
{
	border-width: 5px;
/*	margin: 0px 0px 3px 5px; */
	border-image: url(./images/dialog/image-edit-border-image.png) 5 5 5 5 stretch stretch;
}

QLineEdit:focus,
QComboBox:focus,
QListView:focus
{
	border-image: url(./images/dialog/image-edit-border-image-focused.png) 5 5 5 5 stretch stretch;
}
 </string>
