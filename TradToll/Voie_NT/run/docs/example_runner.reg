[HKEY_LOCAL_MACHINE\SOFTWARE\CSRoute\LaneController\Config\Runner\P2]
;
; SYNTAXE:
;   "modclass_name" = "dllmod_name | ignore_err"
;
;   ignore_err = 0 -> stopper si erreur au lancement des modules de la classe (valeur par defaut)
;   ignore_err = 1 -> continuer si erreur au lancement des modules de la classe
;
