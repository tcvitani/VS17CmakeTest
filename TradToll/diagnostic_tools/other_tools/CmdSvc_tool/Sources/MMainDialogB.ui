QToolBox{
	background-color: #000000;
	
	font: 14pt &quot;CachetBold&quot;;
}
QToolBox QWidget{
	background: transparent;
}

QToolBox QAbstractButton{
	background: transparent;
	color: rgb(209, 139, 0);
	border-style: solid;
	font: 12pt &quot;CachetBold&quot;;
   border-width:0px;
  text-align:left;
	padding-left:60px;
  height:40px;
}

QToolBox::tab{
  background:   transparent;
	border:none;
     border-top-width:1px;
      color: darkgray;
	 border-color:#4d4d4d;
   border-style: solid;
   padding-left:10px;
   margin-left:20px;
   margin-right:20px;

	font: 12pt &quot;CachetBold&quot;;
}

 QToolBox::tab:selected { /* italicize selected tabs */
     color: darkgray;
    border-bottom-width:0px;
}

QToolBox::tab:first { 
     color: darkgray;
      border-top-width:0px;
 }

QToolBox QAbstractButton#qt_toolbox_toolboxbutton { 
  background:   transparent;
	border:none;
       color: darkgray;
	 border-color:#4d4d4d;
   border-style: solid;
   padding-left:10px;
