<IHM_SIMU_script>
	<!-- Synoptique de chenal -->


	<!-- IHM_OBJ_IcoBeacon2  -->
	<ACTION SERVICE="AFFICHAGE" TYPE="SET" OBJECT="IHM_OBJ_IcoBeacon2" VALUE="ImgBeaconOff" VISIBILITY="1"/>
	<ACTION SERVICE="WAIT" MILISEC="50"/>
	<ACTION SERVICE="AFFICHAGE" TYPE="SET" OBJECT="IHM_OBJ_IcoBeacon2" VALUE="ImgBeaconOn" VISIBILITY="1"/>
	<ACTION SERVICE="WAIT" MILISEC="50"/>

	<!-- IHM_OBJ_IcoSignalLight  -->
	<ACTION SERVICE="AFFICHAGE" TYPE="SET" OBJECT="IHM_OBJ_IcoSignalLight" VALUE="ImgWarningOn" VISIBILITY="1"/>
	<ACTION SERVICE="WAIT" MILISEC="500"/>
	<ACTION SERVICE="AFFICHAGE" TYPE="SET" OBJECT="IHM_OBJ_IcoSignalLight" VALUE="ImgWarningOff" VISIBILITY="1"/>
	<ACTION SERVICE="WAIT" MILISEC="50"/>
	
	<!-- IHM_OBJ_IcoExtOpticalBarrier  -->
	<ACTION SERVICE="AFFICHAGE" TYPE="SET" OBJECT="IHM_OBJ_IcoExtOpticalBarrier" VALUE="ImgEntOpticalBarrierOff" VISIBILITY="1"/>
	<ACTION SERVICE="WAIT" MILISEC="50"/>
	<ACTION SERVICE="AFFICHAGE" TYPE="SET" OBJECT="IHM_OBJ_IcoExtOpticalBarrier" VALUE="ImgEntOpticalBarrierOn" VISIBILITY="1"/>
	<ACTION SERVICE="WAIT" MILISEC="50"/>

	<!-- IHM_OBJ_TxtNbCarSAS  -->
	<ACTION SERVICE="AFFICHAGE" TYPE="SET" OBJECT="IHM_OBJ_TxtNbCarSAS" VALUE="NE=2" VISIBILITY="1"/>
	<!--	END Synoptique de chenal -->
</IHM_SIMU_script>
