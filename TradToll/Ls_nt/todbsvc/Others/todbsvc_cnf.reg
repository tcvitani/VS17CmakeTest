[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\ToDBSvc\Parameters\DBRequests]
"BeginLoadRequest"="DECLARE TrfMode CHAR(1); BEGIN IF :ContextId <> 0 THEN  NULL; END IF; IF :OriginId = 0 THEN  TrfMode := LOAD_MES.c_LOAD_ORIGINE_VOIE; ELSIF :OriginId = 1 THEN  TrfMode := LOAD_MES.c_LOAD_ORIGINE_BACKUP_DISK; ELSIF :OriginId = 2 THEN  TrfMode := LOAD_MES.c_LOAD_ORIGINE_BACKUP_TCO; ELSIF :OriginId = 3 THEN  TrfMode := LOAD_MES.c_LOAD_ORIGINE_NON_VOIE; ELSE  RAISE_APPLICATION_ERROR( -20001, 'OriginId>3' ); END IF; LOAD_MES.BLOAD_LANE_TRANSFERT( :PlazaId, :LaneId, TrfMode ); END;"
"LoadMesRequest"="BEGIN LOAD_MES.INSERT_MSG( :NbMsg, :Msg ); END;"
"EndLoadRequest"="BEGIN IF :ErrorFlag <> 0 THEN  LOAD_MES.ELOAD_LANE_TRANSFERT( NULL, LOAD_MES.c_LOAD_ETAT_ERR ); ELSE  LOAD_MES.ELOAD_LANE_TRANSFERT(); END IF; END;"
"LaneListRequest"="BEGIN IF :ContextId <> 0 THEN NULL; END IF; GEN_DEF.Get_Lane_LS( :PlazaId, :PlazaName, :LaneId, :LaneName); :TotalCount := 0; END;"
"SetLastRequest"="BEGIN  IF :ContextId <> 0 THEN  NULL; END IF; IF LOAD_MES.SET_LAST_SEQ_LANE( :PlazaId, :LaneId, :SeqNumber ) = 0 THEN  RAISE_APPLICATION_ERROR( -20001, 'SET_LAST_SEQ_LANE' ); END IF; END;"
"GetLastRequest"="BEGIN IF :ContextId <> 0 THEN  NULL; END IF; IF LOAD_MES.GET_LAST_SEQ_LANE( :PlazaId, :LaneId, :SeqNumber ) = 0 THEN  RAISE_APPLICATION_ERROR( -20001, 'GET_LAST_SEQ_LANE' ); END IF; END;"

