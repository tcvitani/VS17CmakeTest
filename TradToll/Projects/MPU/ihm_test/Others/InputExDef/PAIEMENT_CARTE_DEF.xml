<?xml version="1.0" encoding="UTF-8"?>
<input_definition desktop_css_file="DialogStyleNEP.css">
	<widget type="Label" name="lblTitle"/>
	<widget type="Label" name="lblMessage"/>
	<widget type="Label" name="lblCardNumberTitle"/>
	<widget type="LineEditExt" name="txtProductCodeValue" format="LUHN_KEY" format_detail="lblLuhnKeyValidator" min_len="13" max_len="19" validator="(?=.*[^0].*)(\d+)"/>
	<widget type="LabelLuhnCheck" name="lblLuhnKeyValidator"/>
	<widget type="Label" name="lblExpirationDateTitle"/>
	<widget type="LineEditExt" name="txtExpirationDateValue" format="M" format_detail="99/99;_" validator="^(0[1-9]|1[012])\/[0-9]{2}$"/>
	<widget type="PushButtonOK" name="btnOK"/>
	<widget type="PushButtonCancel" name="btnCancel"/>
</input_definition>
