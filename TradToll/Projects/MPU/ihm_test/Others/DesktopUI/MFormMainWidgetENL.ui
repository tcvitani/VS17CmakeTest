   <property name="styleSheet">
    <string>QFrame,QHBoxLayout
{
	background-color:transparent;
	margin:0px;
}

QFrame#CntFooterGroup
{
	background-image: url(./images/footer-background.png);
	background-repeat:no-repeat;
	background-attachment:fixed;
	background-position: left top; 
	background-color:transparent;
	padding: 0px;
}

QFrame#CntFooterLeft
{
	background-color:transparent;
}

QFrame#CntFooterRight
{
	background-color:transparent;
}

QFrame#btnProduct1 &gt; QPushButton,
QFrame#btnProduct2 &gt; QPushButton,
QFrame#btnProduct3 &gt; QPushButton,
QFrame#btnProduct4 &gt; QPushButton,
QFrame#btnProduct5 &gt; QPushButton
{
	background-image: url(./images/footer-lse-button.png);
	background-color: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #fefefe, stop:1 #b2b2b2);
	border: 1px solid #666666;
	background-repeat:no-repeat;
	background-attachment:fixed;
	background-position: left top;
	padding: 0px;
}

QFrame#btnProduct1 &gt; QPushButton,
QFrame#btnProduct2 &gt; QPushButton,
QFrame#btnProduct3 &gt; QPushButton,
QFrame#btnProduct4 &gt; QPushButton,
QFrame#btnProduct5 &gt; QPushButton
{
	background-color: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #dcdcdc, stop:1 #cccccc);
	color: #b2b2b2;
	border-color: #b2b2b2;
}

QFrame#btnProduct1 &gt; QPushButton,
QFrame#btnProduct2 &gt; QPushButton,
QFrame#btnProduct3 &gt; QPushButton,
QFrame#btnProduct4 &gt; QPushButton,
QFrame#btnProduct5 &gt; QPushButton
{
	background-color: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #cccccc);
	color: #888888;
}

QFrame#CntTaskBar &gt; QPushButton
{
	background-image: url(./images/footer-window-button.png);
	background-repeat: no-repeat;
	background-position: left top;
	background-color: transparent;
	text-align: right;
	padding: 0px 10px 0px 0px;
	border: 0px none;
}
</string>
   </property>
